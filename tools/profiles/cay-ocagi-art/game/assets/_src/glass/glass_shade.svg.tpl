<svg xmlns="http://www.w3.org/2000/svg" width="220" height="480" viewBox="0 0 220 480">
<!-- Thin-waisted Turkish tea glass. Canvas 220x480, glass 200x460, bottom centre at (110,470). Used by GlassView. Layer 3: cylinder shading (child of the mask, above the liquid). -->
<defs><linearGradient id="cyl" x1="10" y1="0" x2="210" y2="0" gradientUnits="userSpaceOnUse">
<stop offset="0" stop-color="{{shade_dark}}" stop-opacity="0.28"/>
<stop offset="0.3" stop-color="{{highlight}}" stop-opacity="0"/>
<stop offset="0.62" stop-color="{{highlight}}" stop-opacity="0.14"/>
<stop offset="1" stop-color="{{shade_dark}}" stop-opacity="0.3"/>
</linearGradient></defs>
<rect x="0" y="0" width="220" height="480" fill="url(#cyl)"/>
</svg>
